# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon connection string (Neon Console > your project > Connect > copy the string).
# Keep sslmode=require. Use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
